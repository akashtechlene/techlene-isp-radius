<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.radiusengine</groupId>
  <artifactId>radiusengine</artifactId>
  <name>RadiusEngine AAA Server</name>
  <version>1.0.0.31-SNAPSHOT</version>
  <description>RADIUS Authentication, Authorization and Accounting (AAA) Server</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <transformers>
                <transformer>
                  <mainClass>com.radiusengine.aaa.server.RadiusAAAServer</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <jersey.version>2.18</jersey.version>
    <pool2.version>2.8.1</pool2.version>
    <slf4j.version>1.7.25</slf4j.version>
    <java.version>1.8</java.version>
    <snmp4j.version>2.8.0</snmp4j.version>
    <ehcache.version>2.10.6</ehcache.version>
    <hikaricp.version>3.4.5</hikaricp.version>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <hk2.version>2.4.0-b12</hk2.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <logback.version>1.2.3</logback.version>
    <jackson.version>2.0.1</jackson.version>
    <protobuf.version>3.6.1</protobuf.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <dbcp2.version>2.8.0</dbcp2.version>
  </properties>
</project>
